# ==============================================================================
# Apache Configuration for voting-admin (React / Vite Single Page Application)
# ==============================================================================

# Disable directory browsing for security (wrapped in mod_autoindex check to avoid 500 error if forbidden by host)
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Ensure correct MIME types for modern web assets (ES modules, CSS, fonts, SVG)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# Single Page Application (SPA) Routing
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the requested URL corresponds to an existing actual file or directory,
  # serve it directly without rewriting (ensures JS, CSS, images, API calls are untouched)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If the requested resource does not exist as a physical file/directory,
  # rewrite the request to index.html so React Router / client-side routing handles it.
  RewriteRule ^ index.html [L]
</IfModule>

# HTTP Security & Caching Headers
<IfModule mod_headers.c>
  # Protect against MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent browsers from caching index.html so users always get the latest app build
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Cache static assets (hashed JS, CSS, images) for better performance
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable Gzip / Deflate compression for improved speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Block access to hidden files and directories (e.g., .env, .git, .htaccess)
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^\.">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
